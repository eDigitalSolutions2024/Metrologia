PORT=4000
NODE_ENV=development

# MongoDB
MONGODB_URI=mongodb://127.0.0.1:27017/metryco

# JWT
JWT_SECRET=change-me
JWT_EXPIRES_IN=1h
JWT_REFRESH_SECRET=change-me-too
JWT_REFRESH_EXPIRES_IN=7d

# CORS - origen del frontend (Vite dev server)
CORS_ORIGIN=http://localhost:5173

# Asistente de incertidumbre (IA de apoyo) e importación inteligente de
# plantillas de incertidumbre / puntos de Performance desde Word o Excel de
# formato libre. Sin esta variable, esas funciones responden en "modo sin IA"
# (heurística local / texto extraído para copiar a mano) en vez de fallar.
# ANTHROPIC_API_KEY=
# ASISTENTE_MODEL=claude-sonnet-5

# Facturación CFDI 4.0 — proveedor de timbrado (PAC). Sin estas 3 variables,
# el módulo de Facturación funciona completo EXCEPTO timbrar/cancelar (esas
# acciones devuelven el error controlado PAC_NOT_CONFIGURED, nunca simulan un
# timbrado). Ver src/services/pac/pac.config.js y docs/FACTURACION.md.
# PAC_PROVIDER=            # "facturama" | "sw" | "finkok" — requiere implementar su adaptador en services/pac/providers/
# PAC_API_KEY=
# PAC_API_SECRET=
# PAC_BASE_URL=
# PAC_SANDBOX=true

# Usado solo por scripts/seedAdmin.js para crear el primer usuario admin
SEED_ADMIN_USUARIO=admin
SEED_ADMIN_PASSWORD=change-me-on-first-login
SEED_ADMIN_NOMBRE=Administrador
SEED_ADMIN_EMAIL=admin@metrycolab.com
